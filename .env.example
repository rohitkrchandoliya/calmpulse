# Copy this file to ".env" and paste your Presage SmartSpectra API key.
# Get a free key by registering at https://physiology.presagetech.com/auth/register
# The key is read only by the local server process. It is never sent to the
# browser, never logged, and must never be committed to git.
SMARTSPECTRA_API_KEY=paste-your-key-here

# Optional: port for the local web app (default 4173).
# PORT=4173






